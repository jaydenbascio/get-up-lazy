{
  "expo": {
    "name": "get-up-lazy",
    "slug": "get-up-lazy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.anonymous.getuplazy",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "22ca2036-0ba6-4d8e-9cc9-d10457d3a48d"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-audio",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan the QR codes that turn off your alarms.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withShowWhenLocked"
    ]
  }
}
